#!/usr/bin/env bash
# 重建 skill 連結：上游原版（Matt、pstack，皆唯讀）＋ overlays/ 補丁＋本 repo 自有 skills。
# 用法：bin/sync-skills [--check | --list]
#   --check  只檢查 overlay 能否套用在目前的上游 checkout，不改任何連結。
#   --list   列出目前可用的 skill：user/model、名稱、來源（含目前目錄的 .claude/skills 專案 skill）。
# 環境變數：MATT_SKILLS（預設 ~/code/skills）、PSTACK_SKILLS（預設 ~/code/pstack）、
#           SKILL_DIRS（預設 ~/.claude/skills 與 ~/.agents/skills）
# 清單檔：matt-skills.txt（相對 skills/，兩層 <類別>/<名稱>）、pstack-skills.txt（相對 skills/，一層 <名稱>）。
# 清單內 `# pin: <SHA>` 註明驗證過的上游版本；checkout 的 HEAD 不同時只警告。
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
MATT=${MATT_SKILLS:-$HOME/code/skills}
PSTACK=${PSTACK_SKILLS:-$HOME/code/pstack}
BUILD=${XDG_DATA_HOME:-$HOME/.local/share}/ron-skills/overlay
read -r -a DESTS <<< "${SKILL_DIRS:-$HOME/.claude/skills $HOME/.agents/skills}"
CHECK=0
[[ ${1:-} == --check ]] && CHECK=1

if [[ ${1:-} == --list ]]; then
  for dir in "${DESTS[0]}"/*/ "$PWD"/.claude/skills/*/; do
    [[ -f $dir/SKILL.md ]] || continue
    real=$(readlink -f "$dir")
    case $real in
      "$BUILD"/*) src=overlay;; "$MATT"/*) src=matt;; "$PSTACK"/*) src=pstack;; "$ROOT"/*) src=ron-skills;;
      "$PWD"/.claude/*) src=project;; *) src=other;;
    esac
    kind=model; grep -q '^disable-model-invocation: true' "$dir/SKILL.md" && kind=user
    printf '%s\t%s\t%s\n' "$kind" "$(basename "$dir")" "$src"
  done | sort -u
  exit 0
fi

declare -A target
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
failed=0

# 處理一個上游：<標籤> <checkout> <清單檔> <SKILL.md 相對 skills/ 的 glob>
sync_source() {
  local label=$1 base=$2 list=$3 glob=$4 rel name src patch pin head
  local -A listed=()
  if [[ ! -d $base/skills ]]; then
    echo "MISSING $label checkout：$base（git clone 後再同步）" >&2; failed=1; return
  fi
  branch=$(git -C "$base" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "非 git 目錄")
  if [[ $branch != main ]] || [[ -n $(git -C "$base" status --porcelain -- skills) ]]; then
    echo "WARN $label checkout 不是乾淨的 main（$branch）；overlay 會套在目前內容上" >&2
  fi
  pin=$(sed -n 's/^# pin: *\([0-9a-f]\{40\}\).*/\1/p' "$list" | head -1)
  head=$(git -C "$base" rev-parse HEAD 2>/dev/null || true)
  if [[ -n $pin && $head != "$pin" ]]; then
    echo "WARN $label HEAD ${head:0:12} 不是 $(basename "$list") 的 pin ${pin:0:12}；驗證後更新 pin" >&2
  fi
  while read -r rel; do
    [[ -z $rel || $rel == \#* ]] && continue
    listed[${rel#-}]=1
    [[ $rel == -* ]] && continue
    name=$(basename "$rel"); src=$base/skills/$rel
    [[ -d $src ]] || { echo "MISSING $label $rel（上游已移除或改名，請更新 $(basename "$list")）" >&2; failed=1; continue; }
    [[ -n ${target[$name]:-} ]] && { echo "DUPLICATE $name（$label 與其他來源同名）" >&2; failed=1; continue; }
    patch=$ROOT/overlays/$name.patch
    if [[ -f $patch ]]; then
      cp -r "$src" "$tmp/$name"
      if ! (cd "$tmp/$name" && git apply "$patch"); then
        echo "OVERLAY_FAILED $name：$patch 無法套用在目前的 $label 版本，請重做補丁" >&2; failed=1; continue
      fi
      target[$name]=$BUILD/$name
    else
      target[$name]=$src
    fi
  done < "$list"
  # 上游新增、清單未列的 skill 只提示：要用就加一行，不用就加 `-<path>`。
  for f in "$base"/skills/$glob/SKILL.md; do
    [[ -f $f ]] || continue
    rel=${f#"$base"/skills/}; rel=${rel%/SKILL.md}
    [[ -n ${listed[$rel]:-} ]] || echo "NEW $label $rel（上游新增；在 $(basename "$list") 加入或以 -$rel 略過）" >&2
  done
}

sync_source Matt "$MATT" "$ROOT/matt-skills.txt" '*/*'
sync_source pstack "$PSTACK" "$ROOT/pstack-skills.txt" '*'

for dir in "$ROOT"/skills/*/*/; do
  [[ -f $dir/SKILL.md ]] && target[$(basename "$dir")]=${dir%/}
done

(( failed )) && exit 1
(( CHECK )) && { echo "CHECK_OK ${#target[@]} skills"; exit 0; }

mkdir -p "$BUILD"
for p in "$ROOT"/overlays/*.patch; do
  name=$(basename "$p" .patch)
  [[ -d $tmp/$name ]] || continue
  rm -rf "${BUILD:?}/$name"; mv "$tmp/$name" "$BUILD/$name"
done

for dest in "${DESTS[@]}"; do
  mkdir -p "$dest"
  # 移除指向受管來源、但已不在清單內的舊連結；其他連結與實體目錄一律不碰。
  for link in "$dest"/*; do
    [[ -L $link ]] || continue
    t=$(readlink "$link")
    case $t in "$MATT"/*|"$PSTACK"/*|"$ROOT"/*|"$BUILD"/*) [[ -n ${target[$(basename "$link")]:-} ]] || rm "$link";; esac
  done
  for name in "${!target[@]}"; do
    if [[ -e $dest/$name && ! -L $dest/$name ]]; then
      echo "SKIP $dest/$name（實體目錄，不覆蓋）" >&2; continue
    fi
    ln -sfn "${target[$name]}" "$dest/$name"
  done
done
echo "SYNCED ${#target[@]} skills → ${DESTS[*]}"
