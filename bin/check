#!/usr/bin/env bash
# 本 repo 唯一的檢查入口：pre-commit、CI 與 issue-run 的 acceptance 都只呼叫它，所有檢查只寫在這裡。
# 用法：bin/check [--upstream]
#   --upstream  先把 Matt 與 pstack 上游最新 main 淺 clone 到暫存目錄再檢查（與 CI 相同）；
#               本機 ~/code/skills 是 fork，會落後上游，只跑本機版本時 overlay 漂移要等 CI 才看得到。
# 環境變數 MATT_SKILLS、PSTACK_SKILLS 同 bin/sync-skills；--upstream 會覆寫它們。
set -euo pipefail
cd "$(dirname "$0")/.."
# 呼叫者帶來的 GIT_DIR、GIT_INDEX_FILE 等會被測試的 git 繼承，fixture 就改到真正的 repo（#25）；不經 pre-commit 直接跑時（`git rebase --exec`）也要清（#301）。
unset $(git rev-parse --local-env-vars)
# 同一棵工作樹只跑一份（#479：背景通知早到，worker 以為中斷又重跑兩次，三份 bin/check 同寫一個 log，全部作廢重跑）。
# pid 記在這棵工作樹自己的 git 目錄；記下的行程還活著、而且是 bin/check 時印 `CHECK_BUSY <pid>`、exit 3，不開第二份。
# 行程已結束（含被 kill、沒跑到 EXIT trap）或 pid 被別的程式重用時視為沒人持有，照常開跑。
# 持有者是自己的祖先（測試在本 repo 跑 bin/check，例如 tests/pre-commit-git-env.test.mjs）時不擋、也不接手：以繼承的 CHECK_LOCK_PID 認出。
lock=$(git rev-parse --path-format=absolute --git-path check.pid)
holder=$(cat "$lock" 2>/dev/null) || holder=
if [[ -z ${CHECK_LOCK_PID:-} || $holder != "$CHECK_LOCK_PID" ]]; then
  if [[ $holder =~ ^[0-9]+$ && $holder != "$$" ]] && ps -p "$holder" -o command= 2>/dev/null | grep -q 'bin/check'; then
    echo "CHECK_BUSY $holder"
    exit 3
  fi
  echo $$ > "$lock"
  export CHECK_LOCK_PID=$$
fi
# 這次檢查的樹：通過時記下，pre-commit 遇到同一棵樹不再跑（scripts/check-stamp.mjs，#297）。取不到不影響檢查。
stamp_tree=$(node scripts/check-stamp.mjs tree 2>/dev/null) || stamp_tree=
# pre-commit 帶入要 commit 的樹（CHECK_INDEX_TREE）時，流程站兩道守門讀那棵樹而不是工作區（#329-4）；CI 與手動跑沒有它，照舊讀工作區。
# 兩棵樹不同時這次沒有完整檢查工作樹，不記 stamp，否則之後 commit 工作樹會被當成已通過而跳過。
index_tree=${CHECK_INDEX_TREE:-}
[[ -z $index_tree || $index_tree == "$stamp_tree" ]] || stamp_tree=

tmp=$(mktemp -d); trap 'rm -rf "$tmp"; [[ $(cat "$lock" 2>/dev/null) != "$$" ]] || rm -f "$lock"' EXIT
# 失敗時最後一行印 `CHECK_FAIL <步驟> [<失敗的測試>｜…]`，和成功時的 CHECK_PASS 對稱：失敗的測試名稱從各組的 log 抽 `✖` 行，
# 只看尾段就知道是哪個測試，不必整條重跑存 log 再 grep（#267：`bin/check | tail -8` 只拿到 stack trace）。<步驟> 是 $step，沒設時是失敗的指令。
step=
check_fail() {
  # 不用 paste -d'｜'：GNU paste 只取分隔符的第一個位元組，兩個以上失敗時整行變成無效 UTF-8（#301）。
  local failed=
  failed=$(cat "$tmp"/*.log 2>/dev/null | sed -n 's/^[[:space:]]*✖ \(.*\) ([0-9.]*m\{0,1\}s)$/\1/p' | sort -u | awk 'NR>1{printf "｜"}{printf "%s",$0}END{if(NR)print ""}') || true
  echo "CHECK_FAIL ${step:-$1}${failed:+ $failed}"
}
trap 'check_fail "$BASH_COMMAND"' ERR
if [[ ${1:-} == --upstream ]]; then
  up=$tmp
  git clone -q --depth 1 https://github.com/mattpocock/skills.git "$up/matt"
  git clone -q --depth 1 https://github.com/backnotprop/pstack.git "$up/pstack"
  export MATT_SKILLS=$up/matt PSTACK_SKILLS=$up/pstack
fi

# 測試不讀使用者的全域與系統 git 設定，本機與 CI 一樣沒有 identity（#204：#173 的測試在 fixture repo 裡 commit 沒帶 user.name，本機兩次 Regression 都過，
# CI 才 `fatal: empty ident name`）。只把 GIT_CONFIG_GLOBAL 換成空檔不夠：macOS 的 git 會從帳號名稱與主機名猜出 identity，所以再設 useConfigOnly。
# HOME 不動，--upstream 的 clone 照常用使用者的設定。
printf '[user]\n\tuseConfigOnly = true\n' > "$tmp/gitconfig"
isolated=(env GIT_CONFIG_GLOBAL="$tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1)

node scripts/check-node-version.mjs
node scripts/check-conflict-markers.mjs
bin/sync-skills --check
node scripts/check-links.mjs
# auto mode 放行的 tracker 寫入（#96）靠 permissions.allow；格式錯的規則 Claude Code 只略過不報錯。
node scripts/check-claude-settings.mjs
# coordinator 自己跑、會寫外部系統的腳本都要有放行規則，缺了就只能交給人跑（#131）；本 repo 讓 coordinator 自己 push，所以帶 --push（#244）。
node scripts/check-coordinator-permissions.mjs --push
node scripts/build-workflow-site.mjs --check ${index_tree:+--tree=$index_tree}
node scripts/check-workflow-strings.mjs
node scripts/check-workflow-secrets.mjs
node scripts/check-workflow-sync.mjs ${index_tree:+--tree=$index_tree}
# 本 repo 與 setup-workflow 的 templates/ 都要在 macOS 與 Linux 上跑（#86）；從 repo 根掃，templates/ 也在範圍內。
node scripts/check-portability.mjs
# 會 spawn git 的正本測試要 import 隔離模組，否則在 git hook 裡跑時 fixture 會改到真正的 repo（#295：漏了 8 支，#291 才補上）。tests/ 不在範圍內：開頭已清掉 GIT_*（#301）。
node scripts/check-test-git-isolation.mjs skills/engineering/setup-workflow/templates
# skill script 的 main guard 要先 realpath argv[1]，否則經 ~/.claude/skills 的 symlink 執行時靜靜 exit 0（4a8c831 修 day-sessions.mjs，#329 ci.mjs 又踩一次）。templates/ 另由 tests/template-main-guard.test.mjs 管。
node scripts/check-main-guard.mjs
# 區域宣告遮蔽同名 import（spay2 retro ff00a288#3：focused 測試全綠，`node --check` 也不報）與 node:test 子行程沒有 t.after kill（spay2 #653：assertion 失敗時子行程讓測試卡到逾時），#348。
node scripts/check-shadowed-imports.mjs scripts skills tests
node scripts/check-test-child-kill.mjs scripts skills tests > /dev/null
# 以真實 .claude/settings.json 的 matcher 驗每個 hook 的 exit code，案例在 scripts/hook-acceptance-cases.json（#348）。--project-dir 指向受檢的這棵樹，
# 不用 session 的 $CLAUDE_PROJECT_DIR（coordinator 在 stage worktree 跑時它指向主 checkout）。通過時不印。
hook_out=$(node scripts/hook-acceptance.mjs --project-dir "$PWD") || { echo "$hook_out"; false; }
# adapter 必讀核心（issue-run.md、pilot.md）各 14000 bytes、拆出檔 58000 bytes，預算表 scripts/adapter-size-budget.json（#344）；通過時不印，失敗時印超過的檔與拆檔提示。
node scripts/check-adapter-size.mjs > /dev/null
# 只讀文件與清單的規則不到兩秒，在整條測試之前先跑：副本與 sha256（#267：第四次踩到）、pilot.md 大小、docs/agents 的裸 gh 寫入與 allow 規則清單（#274：改 adapter 文字等一分鐘才報，
# 本機只跑 check-coordinator-permissions.mjs 看不到 allow 清單那條，開了 PR #280 才在 CI 失敗）。通過時不印（整組測試裡會再跑一次），失敗時印 node 的 failing tests 段。
step=docs-rules
docs_rules=(tests/template-copies.test.mjs tests/pilot-split.test.mjs tests/gh-tracker.test.mjs tests/check-coordinator-permissions.test.mjs tests/pilot-probe-adapter-entries.test.mjs tests/pilot-push-gate-scripts.test.mjs tests/pilot-project-flags.test.mjs)
"${isolated[@]}" node --test --test-reporter=spec "${docs_rules[@]}" > "$tmp/docs-rules.log" 2>&1 || { sed -n '/failing tests:/,$p' "$tmp/docs-rules.log"; false; }
step=tests
# 每組測試各印一行 `ℹ tests <n>`，只看尾段會漏掉前面幾組（retro a6：PR #63、#64 只記到第二組的 120），所以最後彙總成一行。
# 帶 --test-force-exit 的組一律經 node-test-guarded 跑，補跑靜默遺失的測試（#483：高負載時這組少了 31 個測試仍印 CHECK_PASS、exit 0）。
"${isolated[@]}" node skills/engineering/setup-workflow/templates/node-test-guarded.mjs --test-reporter=spec --test-force-exit tests/*.test.mjs | tee "$tmp/tests.log"
# setup-workflow 的 script 正本與測試：先列出檔名（node --test 的輸出不帶檔名），再以正本的 node-test-guarded 跑，它會補跑靜默遺失的測試。
step=template-tests
templates=(skills/engineering/setup-workflow/templates/*.test.mjs)
echo "TEMPLATE_TESTS ${#templates[@]}: ${templates[*]##*/}"
"${isolated[@]}" node skills/engineering/setup-workflow/templates/node-test-guarded.mjs --test-force-exit "${templates[@]}" | tee -a "$tmp/tests.log"
# 用到假 Orca 的測試再以 macOS 樣本跑一次（樣本見 templates/test/fake-orca.mjs 檔頭，#101）。
step=fake-orca-macos
orca_tests=($(grep -l orcaReplySource tests/*.test.mjs "${templates[@]}"))
echo "FAKE_ORCA_PLATFORM=macos ${#orca_tests[@]}: ${orca_tests[*]##*/}"
"${isolated[@]}" FAKE_ORCA_PLATFORM=macos node skills/engineering/setup-workflow/templates/node-test-guarded.mjs --test-force-exit "${orca_tests[@]}" | tee -a "$tmp/tests.log"
[[ -z $stamp_tree ]] || node scripts/check-stamp.mjs record "$stamp_tree" 2>/dev/null || true
# paste 要帶 `-`：macOS 的 BSD paste 沒有檔案參數時不讀 stdin，只印 usage，數字整段消失（#98）。
echo "CHECK_PASS tests $(sed -n 's/^ℹ tests \([0-9]*\)$/\1/p' "$tmp/tests.log" | paste -sd+ -)"
