{
  "permissions": {
    "allow": [
      "Bash(node scripts/gh-tracker.mjs:*)",
      "Bash(node scripts/land.mjs:*)",
      "Bash(node scripts/pilot-close.mjs:*)",
      "Bash(node scripts/pilot-land.mjs push:*)",
      "Bash(node scripts/project-sync.mjs:*)",
      "Bash(node scripts/run-codex-review.mjs:*)",
      "Read(//home/ron/code/**)",
      "Read(//home/ron/orca/workspaces/**)",
      "Read(//tmp/claude-1001/**)",
      "Read(//mnt/c/Users/ron.chang/.orca/**)",
      "Read(~/.claude/**)",
      "Read(~/.local/share/orca/claude-profiles/**)",
      "Read(~/.local/state/orca-tab-titles/**)",
      "Edit(//tmp/claude-1001/**)",
      "Edit(~/.claude/projects/*/memory/**)",
      "Edit(~/.local/share/orca/claude-profiles/*/home/projects/*/memory/**)",
      "Bash(bin/check:*)",
      "Bash(node scripts/adapter-line.mjs:*)",
      "Bash(node scripts/doc-excerpt.mjs:*)",
      "Bash(node scripts/issue-pool.mjs:*)",
      "Bash(node scripts/worktree-overlap.mjs:*)",
      "Bash(node scripts/tab-state.mjs:*)",
      "Bash(node scripts/session-log.mjs:*)",
      "Bash(node scripts/check-adapter-size.mjs:*)",
      "Bash(node scripts/check-workflow-sync.mjs:*)",
      "Bash(node scripts/build-workflow-site.mjs:*)",
      "Bash(node scripts/pilot-probe.mjs:*)",
      "Bash(node scripts/pilot-retro-due.mjs:*)",
      "Bash(node scripts/orca-worktree-create.mjs:*)",
      "Bash(orca-ide terminal list:*)",
      "Bash(orca-ide terminal read:*)",
      "Bash(orca-ide orchestration check:*)"
    ],
    "additionalDirectories": [
      "/home/ron/orca/workspaces/ron-skills"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-unbare.sh\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-zsh-equals.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-bash-pitfalls.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-main-checkout.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-bang-space.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-language.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-tab-state.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-language.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-tab-state.mjs\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hook-language.mjs\""
          }
        ]
      }
    ]
  }
}
